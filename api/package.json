{
  "name": "bot-rec-market",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx --env-file=.env src/server.ts",
    "seed": "tsx src/seed.ts",
    "test": "DATABASE_URL=postgres://bot:bot@localhost:5432/botrec_test PAYMENT_MODE=mock tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:mock": "PAYMENT_MODE=mock tsx src/server.ts",
    "pay:balance": "tsx scripts/payer-balance.ts",
    "pay:recommend": "tsx scripts/pay-recommend.ts",
    "sim:start": "mkdir -p logs && nohup tsx scripts/sim-bots.ts >> logs/sim-main.log 2>&1 &",
    "sim:stop": "bash scripts/sim-stop.sh",
    "supervise": "nohup bash scripts/supervise.sh > /dev/null 2>&1 &"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "x402": "^1.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "x402-fetch": "^1.2.0"
  },
  "overrides": {
    "ws": "^8.22.0"
  }
}
